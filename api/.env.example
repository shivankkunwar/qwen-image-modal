# Copy to api/.env and fill in. Never commit api/.env.
# Base URL printed by `python -m modal deploy qwen_image_modal.py` for the `api` function
MODAL_API_URL=https://YOUR-WORKSPACE--qwen-image-21-api.modal.run
# Modal dashboard -> Settings -> Proxy Auth Tokens
MODAL_KEY=wk-xxxxxxxx
MODAL_SECRET=ws-xxxxxxxx
PORT=8787
# Optional: allow a local dev UI on another port to call this proxy from the browser
# CORS_ORIGIN=http://localhost:3000
